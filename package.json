{
  "name": "pi-setup",
  "version": "0.2.1",
  "private": true,
  "bin": { "pi-setup": "scripts/cli.mjs" },
  "type": "module",
  "description": "Portable Pi configuration with a separate local work layer",
  "engines": { "node": ">=22.19.0" },
  "piRuntimeVersion": "1.1.0",
  "pi": {
    "extensions": ["./extensions", "!extensions/idea-selection/**", "!extensions/idea-selection.*", "!extensions/subagent/**"],
    "skills": ["./skills/*/SKILL.md", "!skills/paiw/**"]
  },
  "files": ["extensions", "skills/*/SKILL.md", "skills/*/references", "skills/*/scripts", "skills/*/assets", "config", "scripts", "README.md", "docs"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "scripts": {
    "check": "node scripts/check-portability.mjs"
  }
}
