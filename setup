#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
# --help must not install anything.
if [ "${1:-}" = "--help" ]; then
  printf '%s\n' './setup [--profile home|work] [--agent-dir PATH] [--dry-run] [--adopt] [--skip-install] [--update]'
  exit 0
fi
if ! command -v node >/dev/null 2>&1; then
  bundled_node="${XDG_DATA_HOME:-$HOME/.local/share}/pi-node/current/bin"
  if [ -x "$bundled_node/node" ]; then
    PATH="$bundled_node:$PATH"
    export PATH
  else
    for arg in "$@"; do
      case "$arg" in --dry-run|--skip-install) printf '%s\n' 'Node.js >=22.19 required; dry/offline mode will not install it.' >&2; exit 1 ;; esac
    done
    printf '%s\n' 'Node.js is missing. Starting the official Pi installer to install prerequisites.'
    installer=$(mktemp)
    trap 'rm -f "$installer"' EXIT HUP INT TERM
    curl -fsSL https://pi.dev/install.sh -o "$installer"
    sh "$installer"
    rm -f "$installer"
    trap - EXIT HUP INT TERM
    PATH="$bundled_node:$PATH"
    export PATH
    command -v node >/dev/null 2>&1 || { printf '%s\n' 'Install Node.js >=22.19 and re-run ./setup.' >&2; exit 1; }
  fi
fi
exec node "$root/scripts/setup.mjs" "$@"
